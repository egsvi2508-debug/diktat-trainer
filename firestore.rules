rules_version = '2';
// Satzlehre Übungen – the app may only ADD feedback and ADD +1 to a counter of the day.
// Nobody can read, change or delete anything through the app; you see everything in the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {

    // feedback: create only, with exactly these fields and a text of at most 2000 characters
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['type', 'text', 'exercise', 'lang', 'created'])
        && request.resource.data.type in ['idea', 'bug', 'praise']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && request.resource.data.exercise is string && request.resource.data.exercise.size() <= 20
        && request.resource.data.lang in ['de', 'en']
        && request.resource.data.created is timestamp;
      allow read, update, delete: if false;
    }

    // one document per day (days/2026-10-11): counters that can only go up by 1
    match /days/{day} {
      allow create: if day.matches('20[0-9]{2}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.size() == 1
        && request.resource.data.keys().hasOnly(counters())
        && request.resource.data[request.resource.data.keys()[0]] == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().size() == 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(counters())
        && upOne('devices') && upOne('opens') && upOne('ex_int') && upOne('ex_lex')
        && upOne('ex_mel') && upOne('ex_sec') && upOne('ex_ter') && upOne('ex_har');
      allow read, delete: if false;
    }

    // a counter stays the same or goes up by exactly 1
    function upOne(f) {
      return request.resource.data.get(f, 0) == resource.data.get(f, 0)
        || request.resource.data.get(f, 0) == resource.data.get(f, 0) + 1;
    }
    function counters() {
      return ['devices', 'opens', 'ex_int', 'ex_lex', 'ex_mel', 'ex_sec', 'ex_ter', 'ex_har'];
    }
  }
}
