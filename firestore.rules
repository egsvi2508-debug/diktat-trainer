rules_version = '2';
// Satzlehre Übungen – the app may only ADD feedback and ADD +1 to a counter of the day.
// Nobody can read, change or delete anything through the app; you see everything in the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {

    // feedback: create only, with exactly these fields and a text of at most 2000 characters
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['type', 'text', 'exercise', 'lang', 'created'])
        && request.resource.data.type in ['idea', 'bug', 'praise']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.exercise is string && request.resource.data.exercise.size() <= 20
        && request.resource.data.lang in ['de', 'en']
        && request.resource.data.created is timestamp;
      allow read, update, delete: if false;
    }

    // daily counters, one document per day (e.g. days/2026-10-11): exactly one field goes up by exactly 1
    match /days/{day} {
      allow create, update: if day.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$') && plusOne();
      allow read, delete: if false;
    }

    function plusOne() {
      let before = resource == null ? {} : resource.data;
      let changed = request.resource.data.diff(before).affectedKeys();
      let field = changed.toList()[0];
      return changed.size() == 1
        && field in ['devices', 'opens', 'ex_int', 'ex_lex', 'ex_mel', 'ex_sec', 'ex_ter', 'ex_har']
        && request.resource.data[field] == before.get(field, 0) + 1;
    }
  }
}
